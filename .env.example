# Konfigurasi deploy produksi (docker compose). Salin ke .env lalu isi.
# Untuk development, pakai apps/api/.env & packages/db/.env seperti biasa.

# URL publik aplikasi (tanpa garis miring di akhir) — dipakai untuk CORS dan
# tautan struk publik (PUBLIC_URL/r/:token).
PUBLIC_URL=https://kasir.contoh.id

# Database (tidak diekspos keluar jaringan compose)
POSTGRES_USER=bisnismu
POSTGRES_PASSWORD=ganti-dengan-password-acak-panjang
POSTGRES_DB=bisnismu

# Rahasia JWT access token — buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET=ganti-dengan-rahasia-acak
JWT_ACCESS_EXPIRES_IN=15m

# Zona waktu server/backup (tanggal laporan memakai zona waktu tiap usaha)
TZ=Asia/Jakarta

# Port HTTP Caddy di host (HTTPS disediakan Cloudflare Tunnel / Tailscale)
HTTP_PORT=80

# Proxy yang dipercaya untuk membaca IP klien asli (lihat apps/api/src/common/utils/trust-proxy.ts)
TRUST_PROXY=loopback,linklocal,uniquelocal

# Backup harian pg_dump — arahkan ke mount NAS
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=14

# Opsional: Cloudflare Tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
